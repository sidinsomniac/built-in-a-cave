{
  "name": "built-in-a-cave",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:sandbox": "vite build --config vite.sandbox.config.ts",
    "predev": "npm run build:sandbox",
    "dev": "vite",
    "prebuild": "npm run build:sandbox",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "validate-content": "vitest run --config vitest.content.config.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@sinonjs/fake-timers": "^15.4.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "axe-core": "^4.14.0",
    "js-yaml": "^5.4.3",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sucrase": "^3.35.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  }
